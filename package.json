{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_config_user_agent || '')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "memory:index": "node scripts/ai-memory-index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "build": "node scripts/build-workspace.mjs",
    "build:landing": "node scripts/build-workspace.mjs landing",
    "deploy:api": "fly deploy -c artifacts/api-server/fly.toml --dockerfile artifacts/api-server/Dockerfile"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.2",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vite": "^5.x.x"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.49.0",
    "@sentry/node": "^10.49.0",
    "@vercel/speed-insights": "^2.0.0",
    "i18next": "^26.0.6",
    "umami": "^2.10.0"
  }
}
