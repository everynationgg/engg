# API Server environment variables (copy to .env and fill in values)
# For Fly.io deployment, set these via `fly secrets set KEY=VALUE`

# OPENAI_API_KEY=sk-proj-...   # Required for /api/tts endpoint
# JWT_SECRET=your-jwt-secret
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
