{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ENGG AI Memory Node Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "type", "status", "source_files"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "memory_node"
    },
    "status": {
      "type": "string",
      "enum": ["active", "proposed", "archived"]
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "priority": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "related_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
