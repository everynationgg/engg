# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Auto-generated files (regenerated at build/dev time)
artifacts/mockup-sandbox/src/.generated/*
!artifacts/mockup-sandbox/src/.generated/
!artifacts/mockup-sandbox/src/.generated/mockup-components.ts

# Backup files
*.old

# Per-artifact build output
artifacts/*/dist/

# Artifact environment files (keep .env.example, not .env)
artifacts/**/.env
!artifacts/**/.env.example

# Dump files
*_dump.txt
chat_dump*.txt
code_dump.txt
api_server_dump.txt
socket_dump.txt

# Temporary/generated assets (Pasted prompts from Replit AI)
attached_assets/Pasted-*.txt
attached_assets/image_*.png
.vercel

# Sentry Config File
.env.sentry-build-plugin
 
*.log
.test
largest-files.txt

# Dev-only seed scripts (security risk)
artifacts/api-server/src/seed-dev.ts
