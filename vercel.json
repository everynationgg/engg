{
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": true
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://engg.fly.dev/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://engg.fly.dev/socket.io/:path*"
    },
    {
      "source": "/((?!api|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}
