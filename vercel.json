{
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": true
    }
  },
  "redirects": [
    {
      "source": "/end",
      "destination": "/errant-night",
      "permanent": false
    },
    {
      "source": "/end/:path*",
      "destination": "/errant-night/:path*",
      "permanent": false
    },
    {
      "source": "/visien",
      "destination": "https://visien-gray.vercel.app/",
      "permanent": false
    },
    {
      "source": "/visien/:path*",
      "destination": "https://visien-gray.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/visein",
      "destination": "https://visien-gray.vercel.app/",
      "permanent": false
    },
    {
      "source": "/visein/:path*",
      "destination": "https://visien-gray.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://engg.fly.dev/api/:path*"
    },
    {
      "source": "/socket.io/",
      "destination": "https://engg.fly.dev/socket.io/"
    },
    {
      "source": "/socket.io",
      "destination": "https://engg.fly.dev/socket.io/"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://engg.fly.dev/socket.io/:path*"
    },
    {
      "source": "/errant-night",
      "destination": "/errant-night/index.html"
    },
    {
      "source": "/errant-night/:path*",
      "destination": "/errant-night/index.html"
    },
    {
      "source": "/((?!api|socket.io|errant-night).*)",
      "destination": "/index.html"
    }
  ]
}
